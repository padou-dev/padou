# Maintainer: p@nos <padou.dev@proton.me>
# padou for the Arch User Repository (AUR). How to publish and update it: CONTRIBUTING.md, "Releasing".
pkgname=padou
pkgver=0.2.0
pkgrel=1
pkgdesc="A private, offline AI assistant for your terminal that knows your machine"
arch=('any')
url="https://github.com/padou-dev/padou"
license=('MIT')
depends=('python' 'python-httpx' 'python-prompt_toolkit' 'python-psutil' 'python-rich' 'python-send2trash')
makedepends=('python-build' 'python-installer' 'python-hatchling')
checkdepends=('python-pytest' 'git')
optdepends=(
  'llama.cpp: the model server (or llama.cpp-vulkan / llama.cpp-cuda for your GPU)'
  'ollama: another model server padou can use'
  'wl-clipboard: /copy on Wayland'
  'man-db: lets padou read manual pages'
  'git: /review and git commands'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/padou-dev/padou/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # run `updpkgsums` after changing pkgver

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  PYTHONPATH=src python -m pytest -q
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 config.example.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
}
